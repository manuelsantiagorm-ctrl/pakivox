    <script>
      function toggleMenu(menuId, arrowId) {
        const menu = document.getElementById(menuId);
        const arrow = document.getElementById(arrowId);

        if (!menu || !arrow) {
          return;
        }

        const shouldOpen = !menu.classList.contains("is-open");

        menu.classList.toggle("is-open", shouldOpen);
        arrow.classList.toggle("bi-chevron-up", shouldOpen);
        arrow.classList.toggle("bi-chevron-down", !shouldOpen);
      }

      function openMenu(menuId, arrowId, toggleId) {
        const menu = document.getElementById(menuId);
        const arrow = document.getElementById(arrowId);
        const toggle = document.getElementById(toggleId);

        if (menu) {
          menu.classList.add("is-open");
        }

        if (arrow) {
          arrow.classList.remove("bi-chevron-down");
          arrow.classList.add("bi-chevron-up");
        }

        if (toggle) {
          toggle.classList.add("is-active");
        }
      }

      function toggleInventoryMenu() {
        toggleMenu("inventory-menu", "inventory-arrow");
      }

      function toggleWarehouseMenu() {
        toggleMenu("warehouse-menu", "warehouse-arrow");
      }

      function toggleSalesMenu() {
        toggleMenu("sales-menu", "sales-arrow");
      }

      function toggleMessagingMenu() {
        toggleMenu("messaging-menu", "messaging-arrow");
      }

      function toggleAccountingMenu() {
        toggleMenu("accounting-menu", "accounting-arrow");
      }

      function toggleTeamMenu() {
        toggleMenu("team-menu", "team-arrow");
      }

      function togglePromotionsMenu() {
        toggleMenu("promotions-menu", "promotions-arrow");
      }

      function normalizePath(path) {
        if (!path) {
          return "/";
        }

        if (path.length > 1 && path.endsWith("/")) {
          return path.slice(0, -1);
        }

        return path;
      }

      function activateCurrentMenu() {
        const path = normalizePath(window.location.pathname);

        const currentSearch = window.location.search || "";

        /*
         * Los combos pertenecen al menú Promociones.
         * El resto de /inventory pertenece a Inventario.
         */
        if (
          path.startsWith("/inventory/combos") ||
          path.startsWith("/promociones")
        ) {
          openMenu("promotions-menu", "promotions-arrow", "promotions-toggle");
        } else if (path.startsWith("/inventory")) {
          openMenu("inventory-menu", "inventory-arrow", "inventory-toggle");
        }

        if (path.startsWith("/warehouse")) {
          openMenu("warehouse-menu", "warehouse-arrow", "warehouse-toggle");
        }

        if (path.startsWith("/sales")) {
          openMenu("sales-menu", "sales-arrow", "sales-toggle");
        }

        if (path.startsWith("/messaging")) {
          openMenu("messaging-menu", "messaging-arrow", "messaging-toggle");
        }

        if (path.startsWith("/finanzas") || path.startsWith("/accounting")) {
          openMenu("accounting-menu", "accounting-arrow", "accounting-toggle");
        }

        if (path.startsWith("/accounts/equipo")) {
          openMenu("team-menu", "team-arrow", "team-toggle");
        }

        let bestLink = null;
        let bestScore = 0;

        document.querySelectorAll("[data-menu-link]").forEach(function (link) {
          link.classList.remove("is-active");

          const rawHref = link.getAttribute("href");

          if (
            !rawHref ||
            rawHref.startsWith("#") ||
            rawHref.startsWith("javascript:")
          ) {
            return;
          }

          const hrefUrl = new URL(rawHref, window.location.origin);

          const hrefPath = normalizePath(hrefUrl.pathname);

          const hrefSearch = hrefUrl.search || "";

          let isMatch = false;

          if (hrefSearch) {
            isMatch = path === hrefPath && currentSearch === hrefSearch;
          } else {
            isMatch =
              path === hrefPath ||
              (hrefPath !== "/" && path.startsWith(hrefPath + "/"));
          }

          if (!isMatch) {
            return;
          }

          const score =
            hrefPath.length + (hrefSearch ? hrefSearch.length + 1000 : 0);

          if (score > bestScore) {
            bestLink = link;
            bestScore = score;
          }
        });

        if (bestLink) {
          bestLink.classList.add("is-active");
        }
      }

      function initializeToasts() {
        const stack = document.getElementById("toast-stack");

        if (!stack) {
          return;
        }

        setTimeout(function () {
          stack.style.opacity = "0";
          stack.style.transform = "translateY(-8px)";
          stack.style.transition = "all .25s ease";

          setTimeout(function () {
            stack.remove();
          }, 300);
        }, 7000);
      }

      document.addEventListener("DOMContentLoaded", function () {
        activateCurrentMenu();
        initializeToasts();
      });

      function openPremiumModal() {
    document.getElementById('premiumModal').classList.add('active');
  }
  function closePremiumModal() {
    document.getElementById('premiumModal').classList.remove('active');
  }
    </script>
    
<script>
  (function () {
    "use strict";

    const notificationIdElement = document.getElementById(
      "notification-sound-id"
    );

    const storageKeyElement = document.getElementById(
      "notification-storage-key"
    );

    if (!notificationIdElement || !storageKeyElement) {
      return;
    }

    const notificationId = JSON.parse(
      notificationIdElement.textContent
    );

    const storageKey = JSON.parse(
      storageKeyElement.textContent
    );
    if (!storageKey) {
        return;
    }
    if (!notificationId) {
        try {
            localStorage.setItem(storageKey, "0");
        } catch (error) {

        }
        return;
    }

    let previousNotificationId = 0;

    try {
      previousNotificationId = Number(
        localStorage.getItem(storageKey) || 0
      );
    } catch (error) {
      previousNotificationId = 0;
    }

    /*
     * La primera vez se establece una referencia sin reproducir todas
     * las alertas antiguas que ya estaban pendientes.
     */
    if (!previousNotificationId) {
      try {
        localStorage.setItem(
          storageKey,
          String(notificationId)
        );
      } catch (error) {
        // El sistema continúa aunque el navegador bloquee localStorage.
      }

      return;
    }

    if (Number(notificationId) <= previousNotificationId) {
      return;
    }

    try {
      localStorage.setItem(
        storageKey,
        String(notificationId)
      );
    } catch (error) {
      // El sonido todavía puede funcionar sin almacenamiento.
    }

    let soundPlayed = false;

    function playNotificationSound() {
      if (soundPlayed) {
        return;
      }

      const AudioContextClass =
        window.AudioContext || window.webkitAudioContext;

      if (!AudioContextClass) {
        return;
      }

      const audioContext = new AudioContextClass();
      const oscillator = audioContext.createOscillator();
      const gainNode = audioContext.createGain();
      const startTime = audioContext.currentTime;

      oscillator.type = "sine";
      oscillator.frequency.setValueAtTime(880, startTime);
      oscillator.frequency.setValueAtTime(1046, startTime + 0.12);

      gainNode.gain.setValueAtTime(0.0001, startTime);
      gainNode.gain.exponentialRampToValueAtTime(
        0.18,
        startTime + 0.02
      );
      gainNode.gain.exponentialRampToValueAtTime(
        0.0001,
        startTime + 0.32
      );

      oscillator.connect(gainNode);
      gainNode.connect(audioContext.destination);

      oscillator.start(startTime);
      oscillator.stop(startTime + 0.34);

      soundPlayed = true;

      document.removeEventListener(
        "pointerdown",
        playNotificationSound
      );

      document.removeEventListener(
        "keydown",
        playNotificationSound
      );
    }

    /*
     * Primero intenta reproducirlo directamente. Si el navegador
     * exige interacción, sonará en el primer clic o tecla.
     */
    try {
      playNotificationSound();
    } catch (error) {
      soundPlayed = false;
    }

    if (!soundPlayed) {
      document.addEventListener(
        "pointerdown",
        playNotificationSound,
        { once: true }
      );

      document.addEventListener(
        "keydown",
        playNotificationSound,
        { once: true }
      );
    }
  })();
</script>
{{ notification_sound_id|json_script:"notification-sound-id" }}
{{ notification_sound_area|json_script:"notification-sound-area" }}
{{ notification_sound_level|json_script:"notification-sound-level" }}
{{ notification_sound_storage_key|json_script:"notification-storage-key" }}

<script>
  (function () {
    "use strict";

    const idElement = document.getElementById(
      "notification-sound-id"
    );

    const areaElement = document.getElementById(
      "notification-sound-area"
    );

    const levelElement = document.getElementById(
      "notification-sound-level"
    );

    const storageElement = document.getElementById(
      "notification-storage-key"
    );

    if (
      !idElement ||
      !areaElement ||
      !levelElement ||
      !storageElement
    ) {
      return;
    }

    const notificationId = Number(
      JSON.parse(idElement.textContent) || 0
    );

    const sourceApp = String(
      JSON.parse(areaElement.textContent) || ""
    ).toLowerCase();

    const notificationLevel = String(
      JSON.parse(levelElement.textContent) || "info"
    ).toLowerCase();

    const storageKey = String(
      JSON.parse(storageElement.textContent) || ""
    );

    if (!storageKey) {
      return;
    }

    /*
     * Cuando no existen alertas, dejamos el navegador preparado
     * para que la primera alerta nueva sí produzca sonido.
     */
    if (!notificationId) {
      try {
        localStorage.setItem(storageKey, "0");
      } catch (error) {
        // La página continúa funcionando.
      }

      return;
    }

    let previousNotificationId = 0;

    try {
      previousNotificationId = Number(
        localStorage.getItem(storageKey) || 0
      );
    } catch (error) {
      previousNotificationId = 0;
    }

    if (notificationId <= previousNotificationId) {
      return;
    }

    /*
     * Marcamos la alerta antes de reproducir para impedir sonidos
     * duplicados por doble carga o recarga rápida.
     */
    try {
      localStorage.setItem(
        storageKey,
        String(notificationId)
      );
    } catch (error) {
      // El audio todavía puede reproducirse.
    }

    const AREA_SOUNDS = {
      payments: {
        wave: "sine",
        frequencies: [740, 988]
      },
      accounting: {
        wave: "sine",
        frequencies: [698, 880]
      },
      inventory: {
        wave: "triangle",
        frequencies: [880, 659]
      },
      purchases: {
        wave: "triangle",
        frequencies: [587, 784]
      },
      warehouse: {
        wave: "square",
        frequencies: [330, 440]
      },
      shipping_hub: {
        wave: "sawtooth",
        frequencies: [523, 784]
      },
      sales: {
        wave: "sine",
        frequencies: [659, 880]
      },
      crm: {
        wave: "sine",
        frequencies: [622, 831]
      },
      messaging: {
        wave: "triangle",
        frequencies: [988, 1175]
      },
      dashboard: {
        wave: "sine",
        frequencies: [523, 659]
      }
    };

    const URGENCY_PATTERNS = {
      info: {
        repetitions: 1,
        duration: 0.18,
        pause: 0.08,
        volume: 0.10
      },
      success: {
        repetitions: 2,
        duration: 0.14,
        pause: 0.07,
        volume: 0.12
      },
      warning: {
        repetitions: 2,
        duration: 0.20,
        pause: 0.11,
        volume: 0.16
      },
      danger: {
        repetitions: 3,
        duration: 0.16,
        pause: 0.07,
        volume: 0.21
      },
      critical: {
        repetitions: 3,
        duration: 0.18,
        pause: 0.05,
        volume: 0.23
      },
      error: {
        repetitions: 3,
        duration: 0.18,
        pause: 0.05,
        volume: 0.23
      }
    };

    const areaSound = AREA_SOUNDS[sourceApp] || {
      wave: "sine",
      frequencies: [660, 880]
    };

    const urgency = URGENCY_PATTERNS[notificationLevel] ||
      URGENCY_PATTERNS.info;

    let soundPlayed = false;

    function createTone(
      audioContext,
      frequency,
      startTime,
      duration,
      volume
    ) {
      const oscillator = audioContext.createOscillator();
      const gainNode = audioContext.createGain();
      const endTime = startTime + duration;

      oscillator.type = areaSound.wave;

      oscillator.frequency.setValueAtTime(
        frequency,
        startTime
      );

      gainNode.gain.setValueAtTime(
        0.0001,
        startTime
      );

      gainNode.gain.exponentialRampToValueAtTime(
        volume,
        startTime + 0.025
      );

      gainNode.gain.exponentialRampToValueAtTime(
        0.0001,
        endTime
      );

      oscillator.connect(gainNode);
      gainNode.connect(audioContext.destination);

      oscillator.start(startTime);
      oscillator.stop(endTime + 0.02);
    }

    function playAuthorizedNotificationSound() {
      if (soundPlayed) {
        return;
      }

      const AudioContextClass =
        window.AudioContext || window.webkitAudioContext;

      if (!AudioContextClass) {
        return;
      }

      const audioContext = new AudioContextClass();

      const playSequence = function () {
        const startTime = audioContext.currentTime + 0.03;
        const noteDuration = urgency.duration / 2;

        for (
          let repetition = 0;
          repetition < urgency.repetitions;
          repetition += 1
        ) {
          const repetitionStart =
            startTime +
            repetition * (
              urgency.duration + urgency.pause
            );

          areaSound.frequencies.forEach(
            function (frequency, noteIndex) {
              createTone(
                audioContext,
                frequency,
                repetitionStart +
                  noteIndex * noteDuration,
                noteDuration,
                urgency.volume
              );
            }
          );
        }

        soundPlayed = true;

        document.removeEventListener(
          "pointerdown",
          playAuthorizedNotificationSound
        );

        document.removeEventListener(
          "keydown",
          playAuthorizedNotificationSound
        );
      };

      if (audioContext.state === "suspended") {
        audioContext.resume()
          .then(playSequence)
          .catch(function () {
            soundPlayed = false;
          });

        return;
      }

      playSequence();
    }

    /*
     * Chrome puede bloquear el audio hasta que exista una interacción.
     * Si sucede, el aviso se reproducirá con el primer clic o tecla.
     */
    try {
      playAuthorizedNotificationSound();
    } catch (error) {
      soundPlayed = false;
    }

    if (!soundPlayed) {
      document.addEventListener(
        "pointerdown",
        playAuthorizedNotificationSound,
        { once: true }
      );

      document.addEventListener(
        "keydown",
        playAuthorizedNotificationSound,
        { once: true }
      );
    }
  })();
</script>
    {% block extra_js %}{% endblock %}
  </body>
</html>
