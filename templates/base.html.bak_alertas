      </form>

    </div>

  {% endif %}

</section>

</nav>

</aside>


<main class="main-content">
        <header class="topbar">
          <div>
            <h1>{% block page_title %} Dashboard CEO {% endblock %}</h1>
            <p>{% block page_subtitle %} Panel general de operación SaaS mayorista / Wholesale SaaS operations panel {% endblock %}</p>
          </div>

          <div class="topbar-actions">
            {% if request.user.is_authenticated and warehouse_company %}
            <form method="post" action="{% url 'accounts:seleccionar_bodega_activa' %}" class="warehouse-selector-form">
              {% csrf_token %}
              <input type="hidden" name="next" value="{{ request.get_full_path }}" />

              <label class="warehouse-selector">
                <i class="bi bi-building"></i>
                <span>
                  <small>Bodega activa</small>
                  <select name="warehouse" onchange="this.form.submit()">
                    <option value="all" {% if active_warehouse_is_all %}selected{% endif %}>
                      Todas las bodegas
                    </option>

                    {% for warehouse in accessible_warehouses %}
                    <option value="{{ warehouse.id }}" {% if active_warehouse and active_warehouse.id == warehouse.id %}selected{% endif %}>
                      {{ warehouse.name }}
                    </option>
                    {% endfor %}
                  </select>
                </span>
              </label>
            </form>
            {% endif %}

            {% if request.user.is_authenticated %}
            <details class="notification-bell">
              <summary aria-label="Abrir notificaciones">
                <i class="bi bi-bell-fill"></i>
                {% if notification_unread_count %}
                <span class="notification-badge">
                  {% if notification_unread_count > 99 %}99+{% else %}{{ notification_unread_count }}{% endif %}
                </span>
                {% endif %}
              </summary>
              <div class="notification-dropdown">
                <div class="notification-dropdown-head">
                  <strong>Notificaciones</strong>
                  <span>{{ notification_unread_count }} sin leer</span>
                </div>
                {% for notification in notification_dropdown_items %}
                <a href="{% url 'notifications:open' notification.id %}" class="notification-dropdown-item level-{{ notification.level }}">
                  <i class="bi {{ notification.icon }}"></i>
                  <span>
                    <strong>{{ notification.title }}</strong>
                    <small>{{ notification.message|truncatechars:105 }}</small>
                  </span>
                </a>
                {% empty %}
                <div class="notification-dropdown-empty">
                  No tienes notificaciones nuevas.
                </div>
                {% endfor %}
                <a href="{% url 'notifications:center' %}" class="notification-dropdown-footer">
                  Ver centro de notificaciones
                </a>
              </div>
            </details>
            {% endif %}

            <span class="badge bg-success">Sistema activo / Active system</span>

            {% if request.user.is_staff or request.user.is_superuser %}
            <a href="/admin/" class="btn btn-sm btn-outline-light"> Admin </a>
            {% endif %}
            
            {% if request.user.is_superuser %}
            <a href="/owner/" class="btn btn-sm btn-warning"> Owner </a>
            {% endif %}
          </div>
        </header>

        {% if messages %}
        <div hidden aria-hidden="true">
          {% for message in messages %}
          <div data-wms-django-message data-tags="{{ message.tags|default:'info' }}">
            {{ message }}
          </div>
          {% endfor %}
        </div>
        {% endif %}

        {% block content %}{% endblock %}
      </main>
    </div>

    <!-- ========================================================= -->
    <!-- 💳 MODAL DE BENEFICIOS PREMIUM & SISTEMA DE PAGO          -->
    <!-- ========================================================= -->
